#!/command/with-contenv sh
# shellcheck shell=sh
# Container-boot reconciliation of per-profile gateway s6 services.
#
# Runs as root after 01-hermes-setup (the stage2 hook) has chowned
# the volume and seeded $OPENAGENTS_HOME, but before s6-rc starts user
# services. /etc/cont-init.d/* scripts run in lexicographic order,
# so the `02-` prefix guarantees ordering.
#
# Service directories under /run/openagents-services/ live on tmpfs and are
# wiped on every container restart. Profile directories under
# $OPENAGENTS_HOME/profiles/ live on the persistent VOLUME. This script
# walks the persistent profiles, recreates the s6 service slots,
# and auto-starts only those whose last recorded state was
# `running` — see openagents_cli/container_boot.py.
#
# The root PID 1 scanner watches /run/service and must never see these writable
# entries. The static profile-gateways service starts a separate s6-svscan as
# hermes against this directory after cont-init completes.
set -e

# Refresh only profiles generated by the OpenOS plugin. The reconciler leaves
# unrelated user profiles and their provider configuration untouched.
(cd /opt/hermes && /opt/hermes/.venv/bin/python -c 'from plugins.openos_engineering.profiles import ensure_profiles; ensure_profiles(["developer", "qa", "intent_classifier", "planner", "product_owner", "skill_author"])') || true

profile_scandir=/run/openagents-services
mkdir -p "$profile_scandir"
chown hermes:hermes "$profile_scandir"
s6-setuidgid hermes chmod 0700 "$profile_scandir"

# Skip the drop when already non-root.
[ "$(id -u)" = 0 ] || exec /opt/hermes/.venv/bin/python -m openagents_cli.container_boot
exec s6-setuidgid hermes /opt/hermes/.venv/bin/python -m openagents_cli.container_boot
