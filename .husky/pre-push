#!/usr/bin/env sh
ROOT="$(git rev-parse --show-toplevel)"
# Pre-push stage of .pre-commit-config.yaml (cargo clippy when pushed commits touch Rust).
BASE="$(git rev-parse -q --verify '@{upstream}' 2>/dev/null || git rev-parse -q --verify origin/HEAD 2>/dev/null || true)"
if [ -n "$BASE" ] && command -v pre-commit >/dev/null 2>&1; then
  (cd "$ROOT" && pre-commit run --hook-stage pre-push --from-ref "$BASE" --to-ref HEAD) || exit 1
fi
cd "$ROOT" && npm run typecheck --if-present || exit 1
cd "$ROOT" && npm run build --if-present || exit 1
