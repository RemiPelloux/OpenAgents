# syntax=docker/dockerfile:1.7
FROM oven/bun:1.3.14-alpine AS opencode-builder
RUN apk add --no-cache build-base python3
WORKDIR /src/OpenCode
COPY --from=opencode . .
COPY --from=opencontract packages/envelope /src/OpenContract/packages/envelope
# @opencontract/envelope resolves through its exports map to dist/, which is
# gitignored. A clean checkout therefore ships source only, and the bundle below
# fails to resolve the package unless the dependency is compiled here first.
RUN cd /src/OpenContract/packages/envelope && bun install && bun run build
RUN bun install --frozen-lockfile && \
    ln -s /src/OpenCode/node_modules /src/OpenContract/node_modules && \
    version="$(bun -e 'console.log(require("./packages/opencode/package.json").version)')" && \
    OPENCODE_VERSION="$version" OPENCODE_CHANNEL=latest \
      bun run --cwd packages/opencode build --single --baseline --skip-embed-web-ui && \
    test -f packages/opencode/dist/opencode-linux-x64-baseline/bin/opencode && \
    install -m 0755 packages/opencode/dist/opencode-linux-x64-baseline/bin/opencode /tmp/opencode && \
    /tmp/opencode --version

FROM rust:1.90.0-alpine3.22@sha256:b4b54b176a74db7e5c68fdfe6029be39a02ccbcfe72b6e5a3e18e2c61b57ae26 AS worker-builder
RUN apk add --no-cache musl-dev && \
    rustup component add rustfmt --toolchain 1.90.0
WORKDIR /src
COPY --from=opencontract . /src/OpenContract
COPY Cargo.toml Cargo.lock ./OpenAgents/
COPY crates ./OpenAgents/crates
WORKDIR /src/OpenAgents
RUN --mount=type=cache,id=openagents-rust-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=openagents-rust-cargo-target,target=/src/OpenAgents/target \
    cargo build --locked --release -p openagents-worker && \
    cp target/release/openagents-worker /tmp/openagents-worker && \
    cp target/release/openagents-sandbox /tmp/openagents-sandbox

FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv-source

FROM alpine:3.24
ENV SHELL=/bin/bash \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN apk upgrade --no-cache \
    && apk add --no-cache aws-cli bash build-base ca-certificates curl gcompat git gnupg nodejs npm openssh-client python3 ripgrep \
    && npm install --global pnpm@9.15.0 \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && addgroup -S -g 10000 openagents \
    && adduser -S -D -u 10000 -G openagents -h /home/openagents openagents

COPY --from=worker-builder /tmp/openagents-worker /usr/local/bin/openagents-worker
COPY --from=worker-builder /tmp/openagents-sandbox /usr/local/bin/openagents-sandbox
COPY --from=opencode-builder /tmp/opencode /usr/local/bin/opencode
RUN /usr/local/bin/opencode --version
COPY --from=worker-builder /usr/local/rustup /usr/local/rustup
COPY --from=worker-builder /usr/local/cargo /usr/local/cargo
COPY --from=uv-source /usr/local/bin/uv /usr/local/bin/uv
COPY --from=opencontract registry /etc/opencontract/registry
COPY skills /opt/openagents/skills
RUN cargo --version | grep -F 'cargo 1.90.0' \
    && rustc --version | grep -F 'rustc 1.90.0' \
    && uv --version | grep -F 'uv 0.11.6' \
    && rustfmt --version \
    && cc --version
RUN mkdir -p /repositories /worktrees /run/openos/connectors \
    && chown -R openagents:openagents /repositories /worktrees /run/openos/connectors /opt/openagents/skills
USER openagents
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/openagents-worker"]
