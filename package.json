{
  "name": "openagents",
  "version": "1.0.0",
  "description": "OpenAgents — self-hosted multi-provider AI agent platform (CLI, gateway, tools, memory, skills).",
  "private": true,
  "workspaces": [
    "apps/*",
    "ui-tui",
    "ui-tui/packages/*",
    "web"
  ],
  "scripts": {
    "postinstall": "echo '✅ Browser tools ready. Run: python run_agent.py --help'",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "audit:fix:tui": "npm audit fix --workspace ui-tui",
    "ai-config": "node ../scripts/ai-config.ts",
    "ai-config:global": "node ../scripts/ai-config.ts global",
    "ai-config:set-global": "node ../scripts/ai-config.ts set-global",
    "ai-config:app": "node ../scripts/ai-config.ts app",
    "ai-config:set-app": "node ../scripts/ai-config.ts set-app",
    "ai-config:providers": "node ../scripts/ai-config.ts providers",
    "ai-config:set-provider": "node ../scripts/ai-config.ts set-provider",
    "ai-config:all": "node ../scripts/ai-config.ts all",
    "ai-config:resolved": "node ../scripts/ai-config.ts resolved"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RemiPelloux/OpenAgents.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RemiPelloux/OpenAgents/issues"
  },
  "homepage": "https://github.com/RemiPelloux/OpenAgents#readme",
  "dependencies": {
    "@streamdown/math": "^1.0.2",
    "agent-browser": "^0.26.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "@assistant-ui/store": "0.2.13",
    "yauzl": "^3.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
